{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "includeFiles": "{site_lib.py,data/**}",
      "excludeFiles": "{og/**,*.jpeg,*.jpg,logo.png}"
    }
  },
  "headers": [
    {
      "comment": "정적 자산은 ?v= 쿼리로 캐시버스팅하므로 장기 캐시가 안전하다.",
      "source": "/(.*)\\.(css|js|png|jpg|jpeg|svg|ico|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/rss.xml", "destination": "/api/rss" },

    { "source": "/region", "destination": "/api/region" },
    { "source": "/region/", "destination": "/api/region" },
    { "source": "/region/:slug", "destination": "/api/region?slug=:slug" },
    { "source": "/region/:slug/", "destination": "/api/region?slug=:slug" },

    { "source": "/지역", "destination": "/api/legacy" },
    { "source": "/지역/", "destination": "/api/legacy" },
    { "source": "/지역/:file", "destination": "/api/legacy?file=:file" },

    { "source": "/%EC%A7%80%EC%97%AD", "destination": "/api/legacy" },
    { "source": "/%EC%A7%80%EC%97%AD/", "destination": "/api/legacy" },
    { "source": "/%EC%A7%80%EC%97%AD/:file", "destination": "/api/legacy?file=:file" },

    { "source": "/:dir/:file(.+\\.html)", "destination": "/api/legacy?file=:file" },

    { "source": "/og/:og", "destination": "/api/legacy?og=:og" }
  ]
}
